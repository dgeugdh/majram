# Instagram Bot Configuration
# تكوين بوت انستقرام

# CAPTCHA Settings
# إعدادات CAPTCHA
CAPTCHA_API_KEY=your_2captcha_api_key_here
CAPTCHA_METHOD=ocr  # ocr, api, manual, mock

# Email Service Settings
# إعدادات خدمة البريد
EMAIL_SERVICE_URL=https://temp-mail.org/api
EMAIL_CHECK_INTERVAL=5
USE_MOCK_EMAIL=true

# Browser Settings
# إعدادات المتصفح
BROWSER_HEADLESS=false
BROWSER_TIMEOUT=30
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Proxy Settings (Optional)
# إعدادات البروكسي (اختياري)
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Instagram Settings
# إعدادات انستقرام
INSTAGRAM_SIGNUP_URL=https://www.instagram.com/accounts/emailsignup/
DELAY_BETWEEN_ACCOUNTS=5
MAX_ACCOUNTS_PER_SESSION=10

# Logging Settings
# إعدادات التسجيل
LOG_LEVEL=INFO
LOG_FILE=logs/instagram_bot.log

# Web Interface Settings
# إعدادات واجهة الويب
WEB_HOST=0.0.0.0
WEB_PORT=5000
WEB_DEBUG=false

# Security Settings
# إعدادات الأمان
ENABLE_HUMAN_VERIFICATION=true
ENABLE_CAPTCHA_SOLVING=true
ENABLE_PHONE_VERIFICATION=true